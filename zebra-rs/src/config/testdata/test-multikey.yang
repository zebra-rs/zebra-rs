module test-multikey {
  yang-version 1.1;
  namespace "urn:zebra:test-multikey";
  prefix tm;

  // Lists with more than one key, for config::multikey_tests. None of
  // the daemon's own models has one.
  container mk {
    list member {
      key "vlan port";
      leaf vlan {
        type string {
          pattern 'Vlan[0-9]+';
        }
      }
      leaf port {
        type string;
      }
      leaf mode {
        mandatory true;
        type enumeration {
          enum tagged;
          enum untagged;
        }
      }
      leaf note {
        type string;
      }
      leaf-list tag {
        type string;
      }
      list inner {
        key "id";
        leaf id {
          type uint8;
        }
        leaf weight {
          type uint8;
        }
      }
    }
    list triple {
      key "a b c";
      leaf a {
        type string;
      }
      leaf b {
        type uint8;
      }
      leaf c {
        type string;
      }
      leaf v {
        type string;
      }
    }
    list address {
      key "name prefix";
      leaf name {
        type string;
      }
      leaf prefix {
        type string {
          pattern '(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}'
                + '([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
                + '/(([0-9])|([1-2][0-9])|(3[0-2]))';
        }
      }
    }
    list single {
      key "name";
      leaf name {
        type string {
          pattern 'Po[0-9]+';
        }
      }
      leaf mtu {
        type uint16;
      }
    }
  }
}
